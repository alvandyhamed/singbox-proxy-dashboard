[Unit]
Description=Proxy control dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=dashboard
Group=dashboard
WorkingDirectory=/opt/proxy-dashboard
EnvironmentFile=/opt/proxy-dashboard/.env
ExecStart=/opt/proxy-dashboard/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8787
Restart=always
RestartSec=5
NoNewPrivileges=false
ProtectSystem=full
ProtectHome=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
