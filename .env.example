# ── Dashboard ────────────────────────────────────────────────────────────────
# Address and port the dashboard listens on
DASHBOARD_BIND=127.0.0.1:8787

# Random secret for session signing — generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SECRET_KEY=change-me-to-a-random-32-plus-byte-string

# Argon2id password hash — generate with:
#   python3 -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('yourpassword'))"
DASHBOARD_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$PLACEHOLDER

# ── sing-box / Clash API ──────────────────────────────────────────────────────
# Must match experimental.clash_api settings in singbox/config.json
CLASH_API_URL=http://127.0.0.1:9090
CLASH_API_SECRET=change-me-clash-api-secret

# ── sing-box paths ────────────────────────────────────────────────────────────
# When running via Docker these point inside the container
SINGBOX_CONFIG=/etc/sing-box/config.json
SINGBOX_RULESET=/etc/sing-box/rules/proxied.json
SINGBOX_BIN=/usr/local/bin/sing-box
SINGBOX_CONTAINER_NAME=singbox

# ── Proxy ports ───────────────────────────────────────────────────────────────
PROXY_PORT=1080        # main mixed SOCKS5+HTTP inbound
STAGING_PORT=11080     # temporary port used during config validation
STAGING_API_PORT=19090

# ── Health checks ─────────────────────────────────────────────────────────────
# Comma-separated HTTPS endpoints the dashboard probes to verify VPN connectivity
HEALTH_TARGETS=https://api.telegram.org,https://discord.com/api/v10/gateway

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=/opt/proxy-dashboard/data/dashboard.db

# ── Optional: Hermes AI agent integration ────────────────────────────────────
# Path to your Hermes config.yaml — leave empty/unset to disable the Hermes tab
# HERMES_CONFIG_PATH=/home/user/.hermes/config.yaml
